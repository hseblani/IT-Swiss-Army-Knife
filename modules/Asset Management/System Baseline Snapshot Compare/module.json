                       "required":  false,
                       "default":  "Baseline"
                   },
                   {
                       "name":  "AddTimestamp",
                       "label":  "Add timestamp",
                       "type":  "checkbox",
                       "required":  false,
                       "default":  true
                   },
                   {
                       "type":  "separator",
                       "label":  "Comparison Selection"
                   },
                   {
                       "name":  "OldSnapshotFile",
                       "label":  "Old snapshot file (JSON)",
                       "type":  "file",
                       "required":  false,
                       "default":  ""
                   },
                   {
                       "name":  "NewSnapshotFile",
                       "label":  "New snapshot file (JSON)",
                       "type":  "file",
                       "required":  false,
                       "default":  ""
                   }
               ]
}
