{
    "Id":  "system-baseline-snapshot-compare",
    "Name":  "System Baseline Snapshot + Compare",
    "Category":  "Asset Management",
    "Order":  3,
    "Shell":  "Pwsh",
    "Description":  "Capture a system baseline snapshot and compare snapshots to detect configuration changes over time.",
    "RunPath":  "run.ps1",
    "Params":  [
                   {
