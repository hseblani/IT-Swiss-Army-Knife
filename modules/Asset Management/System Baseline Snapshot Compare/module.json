                       "label":  "Dry Run (WhatIf)",
                       "type":  "checkbox",
                       "required":  false,
                       "default":  true
                   },
                   {
                       "name":  "InfoNote",
                       "type":  "info",
                       "default":  "Capture a system baseline snapshot and compare snapshots to detect configuration changes over time."
                   },
                   {
                       "name":  "Mode",
                       "label":  "Mode",
                       "type":  "dropdown",
                       "required":  true,
                       "default":  "CreateSnapshot",
                       "options":  [
                                       "CreateSnapshot",
                                       "CompareSnapshots"
                                   ]
                   },
                   {
                       "type":  "separator",
                       "label":  "Snapshot Configuration"
                   },
                   {
                       "name":  "SnapshotFolder",
                       "label":  "Snapshot folder",
                       "type":  "folder",
                       "required":  false,
                       "default":  "__MODULE_OUTPUT__"
                   },
                   {
                       "name":  "SnapshotName",
                       "label":  "Snapshot name",
