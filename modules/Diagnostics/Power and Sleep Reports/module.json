                       "default":  "__MODULE_OUTPUT__"
                   },
                   {
                       "name":  "RunEnergyReport",
                       "label":  "Generate Energy Report (powercfg /energy)",
                       "type":  "checkbox",
                       "required":  false,
                       "default":  false
                   },
                   {
                       "name":  "RunBatteryReport",
